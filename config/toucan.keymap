#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                 &kp TAB   &kp SQT  &kp COMMA &kp DOT &kp P &kp Y    &kp F &kp G &kp C &kp R &kp L &kp BSPC
                 &kp LCTRL &kp A    &kp O     &kp E   &kp U &kp I    &kp D &kp H &kp T &kp N &kp S &kp MINUS
                 &kp LGUI  &kp SEMI &kp Q     &kp J   &kp K &kp X    &kp B &kp M &kp W &kp V &kp Z &kp ESC
                                  &kp LALT &mo 1 &mt LSHIFT SPACE    &mt RSHIFT RETURN  &mo 2 &mt RALT RA(GRAVE)
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp GRAVE &kp EXCL &kp AT &kp POUND &kp DLLR &kp PRCNT    &kp CARET &kp AMPS &kp STAR &kp LPAR  &kp RPAR &kp BSPC
                &kp LCTRL &trans &trans &mkp LCLK &kp LC(F) &mkp RCLK     &kp LBKT  &kp HOME &kp UP   &kp END   &kp EQUAL &kp BSLH
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &kp LC(C) &kp LC(V) &trans           &kp RBKT  &kp LEFT &kp DOWN &kp RIGHT &kp KP_SLASH  &kp QMARK
                                                  &trans &trans &trans    &kp RSHIFT &trans &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp N7 &kp N8 &kp N9 &trans &kp DEL &kp BSPC    &trans &trans &trans &trans &trans &trans
                &kp N4 &kp N5 &kp N6 &trans &trans  &trans      &trans &trans &trans &trans &trans &kp RCTRL
                &kp N1 &kp N2 &kp N3 &kp N0 &trans  &trans      &trans &trans &trans &trans &trans &trans
                                  &kp LALT &trans &kp LSHIFT    &trans &trans &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp F7 &kp F8 &kp F9 &kp F12 &trans &trans   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans &trans &trans
                &kp F4 &kp F5 &kp F6 &kp F11 &trans &trans   &trans       &trans      &trans       &trans &trans &kp RCTRL
                &kp F1 &kp F2 &kp F3 &kp F10 &trans &trans   &trans       &trans      &trans       &trans &trans &trans
                                   &kp LALT &trans &kp LSHIFT   &kp RET &mo 2 &kp RALT
            >;
        };
        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};