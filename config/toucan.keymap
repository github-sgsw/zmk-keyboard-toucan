#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                 &kp TAB   &kp SINGLE_QUOTE &kp COMMA &kp DOT &kp P &kp Y   &kp F &kp G &kp C &kp R &kp L &kp BSPC
                 &kp LEFT_CONTROL &kp A   &kp O     &kp E   &kp U &kp I   &kp D &kp H &kp T &kp N &kp S &kp MINUS
                 &kp LEFT_GUI &kp SEMICOLON &kp Q    &kp J   &kp K &kp X   &kp B &kp M &kp W &kp V &kp Z &kp ESC
                          &kp LALT &lt 1 LSHIFT &mt SPACE LSHIFT   &mt RETURN RSHIFT &mo 2 &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp GRAVE   &kp EXCL      &kp AT       &kp POUND       &kp DLLR       &kp PRCNT        &kp CARET   &kp AMPS   &kp STAR &kp LPAR    &kp RPAR &kp BSPC
                &trans  &trans  &trans &trans &mkp LCLK &mkp RCLK   &kp LBKT &kp HOME &kp UP &kp END &kp EQUAL &kp BSLH
                &kp LSHFT   &trans  &trans       &trans       &trans       &trans         &kp RBKT   &kp LEFT   &kp DOWN &kp RIGHT    &kp FSLH &trans
                                                &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp N7 &kp N8   &kp N9 &trans &trans &kp DEL &kp BSPC   &trans &trans  &trans &trans &trans &trans
                &kp N4 &kp N5   &kp N6 &trans   &trans   &trans      &trans &trans &trans       &trans &trans &trans
                &kp N1 &kp N2   &kp N3 &trans   &trans   &trans      &trans &trans  &trans        &trans &trans &trans
                                          &trans &trans   &trans   &trans   &trans    &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp F7 &kp F8 &kp F9 &kp F12 &trans &trans   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans &trans &kp BSPC
                &kp F4 &kp F5 &kp F6 &kp F11 &trans &trans   &trans       &trans      &trans       &trans &trans &trans
                &kp F1 &kp F2 &kp F3 &kp F10 &trans &trans   &trans       &trans      &trans       &trans &trans &trans
                                   &kp LGUI &mo NAV &kp SPACE   &kp RET &mo 2 &kp RALT
            >;
        };
        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};